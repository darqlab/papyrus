# Papyrus — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ─── Embedding ───────────────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://db:5432/papyrus
DB_USER=papyrus
DB_PASSWORD=changeme

# ─── OCR ──────────────────────────────────────────────────────────────────────
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# LLM post-processing of Tesseract output: true | false
OCR_CORRECTION_ENABLED=false
# Provider for OCR correction: anthropic (default) | ollama | evolink
# Independent of CHAT_PROVIDER — can be set to a different value.
OCR_PROVIDER=anthropic
# Model for OCR correction — set to match the chosen provider
# OCR_CORRECTION_MODEL=claude-sonnet-4-6
# Ollama only (ignored when OCR_PROVIDER != ollama)
# OCR_OLLAMA_BASE_URL=http://localhost:11434
# Optional: path to a custom OCR correction prompt file (must be ≥ 50 chars, non-blank)
# OCR_PROMPT_FILE=

# ─── Archive ──────────────────────────────────────────────────────────────────
# Save original files alongside their extracted text
ARCHIVE_ENABLED=false
ARCHIVE_PATH=/data/papyrus/archive

# ─── Chat ─────────────────────────────────────────────────────────────────────
# LLM provider for the chat endpoint: anthropic (default) | ollama | evolink
CHAT_PROVIDER=anthropic
# Model for the selected provider (default: claude-opus-4-6 for Anthropic)
# CHAT_MODEL=claude-opus-4-6
# Optional: path to a custom system prompt file (must be ≥ 50 chars, non-blank)
# CHAT_PROMPT_FILE=
# Ollama only (ignored when CHAT_PROVIDER != ollama)
# CHAT_OLLAMA_BASE_URL=http://localhost:11434
# CHAT_OLLAMA_MODEL=llama3.2

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required when CHAT_PROVIDER=anthropic or OCR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# ─── Evolink ──────────────────────────────────────────────────────────────────
# Required when CHAT_PROVIDER=evolink or OCR_PROVIDER=evolink
# EVOLINK_API_KEY=sk-evo-...
# EVOLINK_BASE_URL=https://direct.evolink.ai
# CHAT_EVOLINK_MODEL=evolink/auto

# ─── Auth (Zitadel) ───────────────────────────────────────────────────────────
# Required in non-dev mode (omit or leave blank to disable security / use dev profile)

# papyrus-api: browser OAuth2 Login + Bearer JWT validation
ZITADEL_ISSUER_URI=https://<your-instance>.zitadel.cloud
ZITADEL_CLIENT_ID=                        # client ID of the papyrus-web PKCE app
ZITADEL_PROJECT_ID=                       # resource ID of the Papyrus project

# papyrus-mcp: opaque token introspection (validates Zitadel PATs)
# Create an API application (Basic auth) named papyrus-introspect in Zitadel
ZITADEL_INTROSPECTION_URI=https://<your-instance>.zitadel.cloud/oauth/v2/introspect
ZITADEL_INTROSPECTION_CLIENT_ID=          # client ID of the papyrus-introspect API app
ZITADEL_INTROSPECTION_CLIENT_SECRET=      # client secret of the papyrus-introspect API app
