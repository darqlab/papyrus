# Papyrus — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ─── Embedding ───────────────────────────────────────────────────────────────
# Primary embedding provider: voyage | ollama
# Default: voyage (Voyage AI — hosted; best for dev/single-node)
# Switch to ollama for fully offline / production deployments (requires re-ingestion)
VOYAGE_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://db:5432/papyrus
DB_USER=papyrus
DB_PASSWORD=changeme

# ─── OCR ──────────────────────────────────────────────────────────────────────
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# ─── Archive ──────────────────────────────────────────────────────────────────
# Save original OCR-processed files alongside their extracted text
ARCHIVE_ENABLED=false
ARCHIVE_PATH=/data/papyrus/archive

# ─── Chat ─────────────────────────────────────────────────────────────────────
# LLM provider for the chat endpoint: anthropic | ollama
# Default: anthropic
CHAT_PROVIDER=anthropic
# Model used by the selected provider (Anthropic default: claude-opus-4-6)
CHAT_MODEL=claude-opus-4-6
# Optional: path to a custom system prompt file (must be ≥ 50 chars, non-blank)
# If unset, the bundled classpath default is used. Requires restart to take effect.
# CHAT_PROMPT_FILE=
# Ollama only — base URL and model (ignored when CHAT_PROVIDER=anthropic)
# CHAT_OLLAMA_BASE_URL=http://localhost:11434
# CHAT_OLLAMA_MODEL=llama3.2

# ─── Optional ─────────────────────────────────────────────────────────────────
# Required for Anthropic chat and OCR correction
# ANTHROPIC_API_KEY=
# Optional: path to a custom OCR correction prompt file
# OCR_PROMPT_FILE=
