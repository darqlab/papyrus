# Papyrus — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ─── Embedding ───────────────────────────────────────────────────────────────
# Primary embedding provider: voyage | ollama
# Default: voyage (Voyage AI — hosted; best for dev/single-node)
# Switch to ollama for fully offline / production deployments (requires re-ingestion)
VOYAGE_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://db:5432/papyrus
DB_USER=papyrus
DB_PASSWORD=changeme

# ─── OCR ──────────────────────────────────────────────────────────────────────
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# ─── Optional ─────────────────────────────────────────────────────────────────
# Only needed if using Anthropic API directly from the app (not required for MCP server)
# ANTHROPIC_API_KEY=
